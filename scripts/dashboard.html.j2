<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Crucible Dashboard</title>
<style>
  :root {
    --bg: #f7f7f5; --surface: #ffffff; --surface-2: #f0f0ec; --border: #e2e2dc;
    --text: #1c1c1a; --muted: #6b6b66; --accent: #3b5bdb;
    --red: #c92a2a; --red-bg: #fff0f0; --green: #2b8a3e; --green-bg: #ebfbee;
    --amber: #a86400; --amber-bg: #fff4e0;
    color-scheme: only light;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
    font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  main { max-width: 1040px; margin: 0 auto; padding: 40px 16px 64px; }
  h1 { font-size: 30px; margin: 4px 0 6px; }
  h2 { font-size: 20px; margin: 0; }
  code { font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  a { color: var(--accent); }
  .eyebrow { color: var(--muted); font-size: 13px; letter-spacing: .06em; text-transform: uppercase; }
  .lede { color: var(--muted); margin: 0 0 24px; max-width: 680px; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }
  .tile { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
  .tile .v { font-size: 26px; font-weight: 650; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .tile .k { color: var(--muted); font-size: 13px; margin-top: 4px; }
  .tile.good .v { color: var(--green); }
  .tile.warn .v { color: var(--amber); }
  .compare { margin-top: 10px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; font-size: 14px; }
  .compare b { font-variant-numeric: tabular-nums; }
  section.pr { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 18px; margin-top: 22px; }
  .pr-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; margin-bottom: 10px; }
  .pr-head a { margin-left: auto; font-size: 14px; }
  .stats { display: flex; flex-wrap: wrap; gap: 6px 18px; color: var(--muted); font-size: 13px; margin-bottom: 12px; }
  .stats b { color: var(--text); font-variant-numeric: tabular-nums; }
  .tablewrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { color: var(--muted); font-weight: 500; white-space: nowrap; }
  td.nowrap { white-space: nowrap; }
  .pill { font-size: 12px; padding: 2px 8px; border-radius: 999px; background: var(--surface-2); color: var(--muted); white-space: nowrap; }
  .st { font-size: 12px; font-weight: 600; white-space: nowrap; }
  .red { color: var(--red); background: var(--red-bg); padding: 1px 6px; border-radius: 5px; }
  .green { color: var(--green); background: var(--green-bg); padding: 1px 6px; border-radius: 5px; }
  .amber { color: var(--amber); background: var(--amber-bg); padding: 1px 6px; border-radius: 5px; }
  .note { color: var(--muted); font-size: 13px; margin: 4px 0 0; }
  details { margin-top: 12px; }
  summary { cursor: pointer; color: var(--accent); font-size: 14px; }
  ul.noise { margin: 8px 0 0; padding-left: 18px; font-size: 14px; }
  ul.noise li { margin: 3px 0; }
  .muted { color: var(--muted); }
  footer { color: var(--muted); font-size: 13px; margin-top: 36px; }
</style>
</head>
<body>
<main>
  <p style="margin:0 0 18px"><a href="../">← Crucible home</a></p>
  <div class="eyebrow">Crucible · IBM Bob 2.0 Hackathon</div>
  <h1>Only proven bugs reach the reviewer</h1>
  <p class="lede">Four parallel attacker agents tried to break three pull requests. A deterministic verifier kept a
    suspicion only if its test failed on the PR, blamed the PR, failed 3 of 3 runs and cited a real spec rule.
    Every reported finding ships with its proof test and its fix.</p>

  <div class="tiles">
    <div class="tile"><div class="v">{{ totals.raw_suspicions }}</div><div class="k">Raw suspicions</div></div>
    <div class="tile good"><div class="v">{{ totals.proven }}</div><div class="k">Proven by failing test</div></div>
    <div class="tile"><div class="v">{{ totals.rejected }}</div><div class="k">Noise rejected</div></div>
    <div class="tile good"><div class="v">{{ totals.fixed }}</div><div class="k">Fixed, proof green 3/3</div></div>
    <div class="tile {{ 'warn' if totals.unfixed else '' }}"><div class="v">{{ totals.unfixed }}</div><div class="k">Flagged for a human</div></div>
    <div class="tile"><div class="v">{{ totals.precision_pct | int }}%</div><div class="k">Precision of reported findings</div></div>
    <div class="tile"><div class="v">{{ totals.fix_rate_pct }}%</div><div class="k">Fix rate</div></div>
    <div class="tile"><div class="v">{{ (totals.total_seconds / 60) | round(1) }}m</div><div class="k">Pipeline time, 3 PRs</div></div>
  </div>
  <div class="compare">
    {% if totals.baseline_comments is not none %}
    Plain AI review on the same PRs: <b>{{ totals.baseline_comments }}</b> comments, of which
    <b>{{ totals.baseline_comments_on_proven_bugs }}</b> point at a proven bug
    ({{ totals.baseline_precision_pct }}%). Crucible reported <b>{{ totals.proven }}</b> findings, every one with a failing test.
    {% else %}
    <span class="muted">Baseline comparison (plain AI review on the same PRs): not recorded yet.</span>
    {% endif %}
  </div>

  {% for p in prs %}
  <section class="pr">
    <div class="pr-head">
      <h2><code>{{ p.pr }}</code></h2>
      <span class="pill">attack: {{ p.attack_mode or "n/a" }}</span>
      <a href="{{ p.report }}">Full report →</a>
    </div>
    <div class="stats">
      <span><b>{{ p.raw_suspicions }}</b> suspicions</span>
      <span><b>{{ p.proven }}</b> proven</span>
      <span><b>{{ p.rejected }}</b> rejected</span>
      <span><b>{{ p.distinct_fixes }}</b> distinct fixes</span>
      <span><b>{{ p.fixed }}</b> fixed</span>
      <span><b>{{ p.unfixed }}</b> unfixed</span>
      <span><b>{{ p.total_seconds }}s</b> pipeline</span>
      {% if p.baseline_comments is not none %}<span>baseline: <b>{{ p.baseline_comments }}</b> comments, <b>{{ p.baseline_comments_on_proven_bugs }}</b> on a proven bug</span>{% endif %}
    </div>
    <div class="tablewrap">
    <table>
      <tr><th>ID</th><th>Lens</th><th>Claim</th><th>Basis</th><th>Status</th><th>Fix</th></tr>
      {% for f in p.findings %}
      <tr>
        <td class="nowrap"><b>{{ f.id }}</b></td>
        <td><span class="pill">{{ f.lens }}</span></td>
        <td>{{ f.claim }}{% if f.unfixed_reason %}<p class="note">{{ f.unfixed_reason }}</p>{% endif %}</td>
        <td class="nowrap"><code>{{ f.basis | replace("spec/orders.md#", "") }}</code></td>
        <td class="st">
          <span class="red">RED {{ f.gate_results.repro }}</span>
          {% if f.after_fix and f.after_fix.passes %}→ <span class="green">GREEN {{ f.after_fix.runs }}</span>
          {% else %}→ <span class="amber">UNFIXED</span>{% endif %}
        </td>
        <td class="nowrap">{% if f.fix_commit %}<code>{{ f.fix_commit }}</code>{% else %}<span class="muted">—</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </table>
    </div>
    <details>
      <summary>Noise rejected ({{ p.noise | length }})</summary>
      <ul class="noise">
        {% for v in p.noise %}<li><b>{{ v.id }}</b> · {{ v.lens }} · <span class="muted">{{ v.reason }}</span> — {{ v.claim }}</li>{% endfor %}
      </ul>
    </details>
  </section>
  {% endfor %}

  <footer>Built by <code>scripts/build_dashboard.py</code> from <code>runs/summary.json</code> and
    <code>runs/*/verdicts.json</code>. Bugs were planted in a sample FastAPI app for this demo.</footer>
</main>
<script type="application/json" id="summary-data">{{ summary_json | safe }}</script>
</body>
</html>
