<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Crucible</title>
<style>
  :root {
    --bg: #f7f7f5; --surface: #ffffff; --surface-2: #f0f0ec; --border: #e2e2dc;
    --text: #1c1c1a; --muted: #6b6b66; --accent: #3b5bdb; --accent-text: #ffffff;
    --red: #c92a2a; --red-bg: #fff0f0; --green: #2b8a3e; --green-bg: #ebfbee;
    --amber: #a86400; --amber-bg: #fff4e0; --code-bg: #f4f4f1;
    color-scheme: only light;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
    font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  main { max-width: 1040px; margin: 0 auto; padding: 0 16px 64px; }
  code, pre { font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  a { color: var(--accent); }
  nav { display: flex; align-items: center; gap: 18px; padding: 18px 0; }
  nav .brand { font-weight: 700; font-size: 17px; letter-spacing: -.01em; }
  nav .spacer { flex: 1; }
  nav a { font-size: 14px; text-decoration: none; }
  .hero { padding: 28px 0 8px; }
  .eyebrow { color: var(--muted); font-size: 13px; letter-spacing: .06em; text-transform: uppercase; }
  h1 { font-size: 34px; line-height: 1.15; margin: 6px 0 10px; letter-spacing: -.02em; }
  h2 { font-size: 20px; margin: 44px 0 14px; }
  .lede { color: var(--muted); font-size: 16px; max-width: 700px; margin: 0; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(135px, 1fr)); gap: 10px; }
  .tile { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
  .tile .v { font-size: 26px; font-weight: 650; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .tile .k { color: var(--muted); font-size: 13px; margin-top: 4px; }
  .tile.good .v { color: var(--green); }
  .tile.warn .v { color: var(--amber); }
  .more { margin-top: 10px; font-size: 14px; }

  .steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
  @media (max-width: 860px) { .steps { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); } }
  .step { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
  .step .n { font-size: 12px; color: var(--muted); }
  .step .t { font-weight: 650; margin: 2px 0 4px; }
  .step .d { font-size: 13px; color: var(--muted); }
  .who { display: inline-block; font-size: 11px; font-weight: 600; padding: 1px 7px; border-radius: 999px; margin-top: 8px; }
  .who.bob { background: #e7ecff; color: #2c46b8; }
  .who.cli { background: var(--green-bg); color: var(--green); }

  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; }
  .stage { border-top: 1px solid var(--border); padding-top: 16px; margin-top: 16px; }
  .stage:first-child { border-top: 0; padding-top: 0; margin-top: 0; }
  .stage h3 { font-size: 15px; margin: 0 0 10px; }
  .stage h3 span { color: var(--muted); font-weight: 500; margin-right: 6px; }
  .drop { border: 1.5px dashed var(--border); border-radius: 10px; padding: 22px; text-align: center; color: var(--muted); transition: border-color .15s, background .15s; }
  .drop.over { border-color: var(--accent); background: var(--surface-2); }
  .row { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; }
  .row > label { flex: 1 1 200px; }
  label { display: block; font-size: 13px; color: var(--muted); }
  input[type=text], select { width: 100%; margin-top: 4px; padding: 8px 10px; font: inherit; color: var(--text);
    background: var(--bg); border: 1px solid var(--border); border-radius: 8px; }
  button { font: inherit; font-weight: 600; padding: 8px 16px; border-radius: 8px; border: 1px solid var(--border);
    background: var(--surface-2); color: var(--text); cursor: pointer; }
  button.primary { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }
  button:disabled { opacity: .5; cursor: default; }
  .or { color: var(--muted); font-size: 13px; margin: 12px 0 6px; }
  .note { color: var(--muted); font-size: 13px; margin: 10px 0 0; }
  .msg { margin-top: 10px; font-size: 14px; }
  .msg.err { color: var(--red); }
  .msg.ok { color: var(--green); }
  details summary { cursor: pointer; color: var(--accent); font-size: 14px; margin-top: 12px; }
  pre.log { background: var(--code-bg); border: 1px solid var(--border); border-radius: 8px; padding: 12px;
    max-height: 260px; overflow: auto; white-space: pre-wrap; margin: 10px 0 0; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; margin-top: 12px; }
  th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { color: var(--muted); font-weight: 500; }
  .pill { font-size: 12px; font-weight: 600; padding: 1px 7px; border-radius: 5px; white-space: nowrap; }
  .pill.proven { color: var(--green); background: var(--green-bg); }
  .pill.rejected { color: var(--muted); background: var(--surface-2); }
  .hidden { display: none; }
  footer { color: var(--muted); font-size: 13px; margin-top: 40px; }
</style>
</head>
<body>
<main>
  <nav>
    <span class="brand">Crucible</span>
    <span class="spacer"></span>
    <a href="#check">Check a PR</a>
    <a href="/dashboard/">Results dashboard</a>
  </nav>

  <section class="hero">
    <div class="eyebrow">Code review built on IBM Bob</div>
    <h1>Only proven bugs reach the reviewer.</h1>
    <p class="lede">IBM Bob attacks a pull request from four angles at once. Crucible keeps a finding only if a test
      proves it, then the bug is fixed and the proof stays as a regression test. The AI raises suspicions; a strict,
      deterministic verifier decides.</p>
  </section>

  {% if totals %}
  <h2>Results on the demo: 3 pull requests</h2>
  <div class="tiles">
    <div class="tile"><div class="v">{{ totals.raw_suspicions }}</div><div class="k">Suspicions raised by Bob</div></div>
    <div class="tile good"><div class="v">{{ totals.proven }}</div><div class="k">Proven by a failing test</div></div>
    <div class="tile"><div class="v">{{ totals.rejected }}</div><div class="k">Noise filtered out</div></div>
    <div class="tile good"><div class="v">{{ totals.fixed }}</div><div class="k">Fixed, red → green</div></div>
    <div class="tile {{ 'warn' if totals.unfixed else '' }}"><div class="v">{{ totals.unfixed }}</div><div class="k">Flagged for a human</div></div>
    <div class="tile"><div class="v">{{ totals.precision_pct | int }}%</div><div class="k">Reported findings with proof</div></div>
  </div>
  <p class="more"><a href="/dashboard/">See every finding, proof test and fix →</a></p>
  {% endif %}

  <h2>How it works</h2>
  <div class="steps">
    <div class="step"><div class="n">1</div><div class="t">Read intent</div>
      <div class="d">Reads the diff, ticket and spec; lists the rules the PR must obey.</div><span class="who bob">IBM Bob</span></div>
    <div class="step"><div class="n">2</div><div class="t">Attack ×4, in parallel</div>
      <div class="d">Edge, security, state and spec attackers each write tests that should break the PR.</div><span class="who bob">IBM Bob subagents</span></div>
    <div class="step"><div class="n">3</div><div class="t">Verify: 4 proof gates</div>
      <div class="d">Fails on the PR, caused by the PR, fails 3 of 3 runs, cites a real rule. Else: noise.</div><span class="who cli">Crucible CLI · no AI</span></div>
    <div class="step"><div class="n">4</div><div class="t">Fix</div>
      <div class="d">Patch until every proof test passes; conflicts are flagged for a human.</div><span class="who bob">Fixer playbook</span></div>
    <div class="step"><div class="n">5</div><div class="t">Report</div>
      <div class="d">Each proven bug with its rule, proof test, fix and red → green status.</div><span class="who cli">Crucible CLI</span></div>
  </div>

  <h2 id="check">Check a pull request</h2>
  <div class="panel">
    <div class="stage">
      <h3><span>1</span>Upload a git repository</h3>
      <div class="row" style="align-items:center; margin-bottom:14px">
        <button class="primary" id="useSample">Try the sample repo</button>
        <span class="note" style="margin:0">A FastAPI orders service with 3 pull requests and IBM Bob's attacker output ·
          <a href="/examples/orders-service-demo.zip" download>download it as a .zip</a></span>
      </div>
      <div class="drop" id="drop">Drop a <b>.zip</b> of the repo here (include the hidden <code>.git</code> folder)<br><br>
        <button id="pickZip">Choose .zip</button>
        <button id="pickFolder">Choose folder</button>
        <input type="file" id="zipInput" accept=".zip" class="hidden">
        <input type="file" id="folderInput" webkitdirectory multiple class="hidden">
      </div>
      {% if not hosted %}
      <div class="or">or use a repository on this machine</div>
      <div class="row">
        <label>Path<input type="text" id="localPath" placeholder="/path/to/repo"></label>
        <button id="loadLocal">Load</button>
      </div>
      {% endif %}
      <div class="msg" id="uploadMsg"></div>
      <p class="note">The repo needs a base branch, a PR branch, and IBM Bob's attacker output from the
        <code>.bob/playbook/</code>: <code>runs/&lt;pr&gt;/findings/&lt;lens&gt;.json</code> plus the tests they point to.
        {% if hosted %}Tests run in an isolated server container for up to 60 seconds each.{% else %}Crucible runs those tests on this machine, so only upload code you trust.{% endif %}</p>
    </div>

    <div class="stage hidden" id="configStage">
      <h3><span>2</span>Choose what to verify</h3>
      <div class="row">
        <label>Base branch<select id="base"></select></label>
        <label>Pull request branch<select id="pr"></select></label>
        <label>Bob's attacker output<select id="runDir"></select></label>
      </div>
      <details>
        <summary>Project layout (from crucible.toml, or the defaults)</summary>
        <div class="row" style="margin-top:10px">
          <label>Project dir<input type="text" id="project_dir"></label>
          <label>App code dir<input type="text" id="app_dir"></label>
          <label>Tests dir<input type="text" id="tests_dir"></label>
          <label>Spec file<input type="text" id="spec_file"></label>
        </div>
      </details>
      <div style="margin-top:14px"><button class="primary" id="run">Run proof gates</button></div>
    </div>

    <div class="stage hidden" id="runStage">
      <h3><span>3</span>Verification</h3>
      <div class="msg" id="runMsg"></div>
      <div id="results" class="hidden">
        <div class="tiles">
          <div class="tile"><div class="v" id="rTotal"></div><div class="k">Suspicions</div></div>
          <div class="tile good"><div class="v" id="rProven"></div><div class="k">Proven</div></div>
          <div class="tile"><div class="v" id="rRejected"></div><div class="k">Rejected as noise</div></div>
        </div>
        <p class="more"><a id="reportLink" target="_blank" href="#">Open the full report →</a></p>
        <table id="verdicts"><thead><tr><th>ID</th><th>Lens</th><th>Claim</th><th>Basis</th><th>Verdict</th></tr></thead><tbody></tbody></table>
      </div>
      <details open><summary>Live log</summary><pre class="log" id="log"></pre></details>
    </div>
  </div>

  <footer>Crucible · IBM Bob 2.0 Hackathon. Bugs in the demo were planted in a sample FastAPI app.
    {% if not hosted %}Runs locally on 127.0.0.1.{% endif %}</footer>
</main>

<script>
const $ = (id) => document.getElementById(id);
let upload = null;

function setMsg(el, text, kind) { el.textContent = text; el.className = "msg " + (kind || ""); }

async function send(url, options) {
  const r = await fetch(url, options);
  const body = await r.json().catch(() => ({}));
  if (!r.ok) throw new Error(body.detail || r.statusText);
  return body;
}

function fill(select, values, chosen) {
  select.innerHTML = values.map(v => `<option${v === chosen ? " selected" : ""}>${v}</option>`).join("");
}

function showRepo(info) {
  upload = info;
  setMsg($("uploadMsg"), `Loaded ${info.name}: ${info.refs.length} branches/tags, ${info.run_dirs.length} attacker output folder(s).`, "ok");
  const prGuess = info.refs.find(r => r.endsWith("-original")) || info.refs.find(r => r !== info.base_guess && /pr|feature/i.test(r)) || info.refs.find(r => r !== info.base_guess);
  fill($("base"), info.refs, info.base_guess);
  fill($("pr"), info.refs, prGuess);
  fill($("runDir"), info.run_dirs, info.run_dirs.find(d => prGuess && d.includes(prGuess.replace(/-original$/, ""))) || info.run_dirs[0]);
  for (const k of ["project_dir", "app_dir", "tests_dir", "spec_file"]) $(k).value = info.layout[k];
  $("configStage").classList.remove("hidden");
  if (!info.run_dirs.length) setMsg($("uploadMsg"), "No attacker output found (runs/<pr>/findings/). Run the Bob attack playbook first.", "err");
}

async function uploadFiles(files, folder) {
  const fd = new FormData();
  for (const f of files) {
    fd.append("files", f);
    if (folder) fd.append("paths", f.webkitRelativePath);
  }
  setMsg($("uploadMsg"), `Uploading ${files.length} file(s)…`);
  try { showRepo(await send("/api/upload", { method: "POST", body: fd })); }
  catch (e) { setMsg($("uploadMsg"), e.message, "err"); }
}

$("pickZip").onclick = () => $("zipInput").click();
$("pickFolder").onclick = () => $("folderInput").click();
$("zipInput").onchange = (e) => e.target.files.length && uploadFiles(e.target.files, false);
$("folderInput").onchange = (e) => e.target.files.length && uploadFiles(e.target.files, true);
const drop = $("drop");
drop.ondragover = (e) => { e.preventDefault(); drop.classList.add("over"); };
drop.ondragleave = () => drop.classList.remove("over");
drop.ondrop = (e) => { e.preventDefault(); drop.classList.remove("over"); if (e.dataTransfer.files.length) uploadFiles(e.dataTransfer.files, false); };

$("useSample").onclick = async () => {
  setMsg($("uploadMsg"), "Loading the sample repository…");
  try { showRepo(await send("/api/sample", { method: "POST" })); }
  catch (e) { setMsg($("uploadMsg"), e.message, "err"); }
};

if ($("loadLocal")) $("loadLocal").onclick = async () => {
  setMsg($("uploadMsg"), "Copying repository…");
  try { showRepo(await send("/api/local", { method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ path: $("localPath").value }) })); }
  catch (e) { setMsg($("uploadMsg"), e.message, "err"); }
};

function renderResults(res, reportUrl) {
  $("rTotal").textContent = res.total; $("rProven").textContent = res.proven; $("rRejected").textContent = res.rejected;
  $("reportLink").href = reportUrl;
  const esc = (s) => String(s ?? "").replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  $("verdicts").querySelector("tbody").innerHTML = res.verdicts
    .sort((a, b) => (a.verdict === "PROVEN" ? 0 : 1) - (b.verdict === "PROVEN" ? 0 : 1))
    .map(v => `<tr><td><b>${esc(v.id)}</b></td><td>${esc(v.lens)}</td><td>${esc(v.claim)}</td>
      <td><code>${esc(v.basis)}</code></td>
      <td>${v.verdict === "PROVEN" ? '<span class="pill proven">PROVEN</span>'
          : `<span class="pill rejected">REJECTED</span> <span class="note">${esc(v.reason)}</span>`}</td></tr>`).join("");
  $("results").classList.remove("hidden");
}

$("run").onclick = async () => {
  if (!upload) return;
  $("run").disabled = true;
  $("runStage").classList.remove("hidden");
  $("results").classList.add("hidden");
  $("log").textContent = "";
  setMsg($("runMsg"), "Running proof gates: each test runs on the PR (3×) and on the base branch…");
  const layout = {};
  for (const k of ["project_dir", "app_dir", "tests_dir", "spec_file"]) layout[k] = $(k).value;
  try {
    const { job_id } = await send("/api/jobs", { method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ upload_id: upload.upload_id, base: $("base").value, pr: $("pr").value, run_dir: $("runDir").value, layout }) });
    const poll = async () => {
      const j = await send(`/api/jobs/${job_id}`);
      $("log").textContent = j.log; $("log").scrollTop = $("log").scrollHeight;
      if (j.status === "done") { setMsg($("runMsg"), "Done.", "ok"); renderResults(j.result, j.report_url); $("run").disabled = false; }
      else if (j.status === "failed") { setMsg($("runMsg"), j.error, "err"); $("run").disabled = false; }
      else setTimeout(poll, 1000);
    };
    poll();
  } catch (e) { setMsg($("runMsg"), e.message, "err"); $("run").disabled = false; }
};
</script>
</body>
</html>
